generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  DOCTOR
}

enum Gender {
  MALE
  FEMALE
}

enum NotificationType {
  REMINDER
  MESSAGE
  URGENT
}

enum FormType {
  ASK_DOCTOR
  MEDICAL_CASES
  PRESCRIPTION
  PAPERS
}

enum NotificationStatus {
  PENDING
  SENT
}

model Admin {
  id              Int            @id @unique @default(autoincrement())
  authId          String         @unique
  name            String
  email           String         @unique
  role            AdminRole      @default(DOCTOR)
  phone           String?
  fcmToken        String?
  online          Boolean        @default(false)
  profilePicture  String?
  notification    Notification[]
  requests        Request[]
  whatsappGroupId String?
}

model User {
  id              Int            @id @unique @default(autoincrement())
  authId          String         @unique
  identitynumber  String         @unique
  name            String
  email           String         @unique
  phone           String         @unique
  fcmToken        String?
  online          Boolean        @default(false)
  profilePicture  String?
  isverified      Boolean        @default(false)
  village         Village?       @relation(fields: [villageId], references: [id])
  villageId       Int?
  changedPassword Boolean        @default(false)
  gender          Gender         @default(MALE)
  notification    Notification[]
  Request         Request[]
  forms           Form[]
}

model Notification {
  id        Int                @id @unique @default(autoincrement())
  title     String
  body      String
  content   Json?
  read      Boolean            @default(false)
  type      NotificationType
  user      User?              @relation(fields: [userId], references: [id])
  userId    Int?
  admin     Admin?             @relation(fields: [adminId], references: [id])
  adminId   Int?
  dateTime  DateTime?
  status    NotificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
}

model Request {
  id        Int      @id @unique @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  Admin     Admin?   @relation(fields: [adminId], references: [id])
  adminId   Int?
  createdAt DateTime @default(now())
}

model Form {
  id                  Int      @id @unique @default(autoincrement())
  type                FormType
  symptoms            String?
  howToHelp           String?
  medication          String?
  requestedPapers     String?
  media               String[]
  duration            String?
  intensity           String?
  otherSymptoms       String?
  currentTemperature  String?
  currentHeartBeat    String?
  oxgyenLevel         String?
  bloodPressure       String?
  theMedicationReason String?
  medicineRenew       Boolean?
  notes               String?
  user                User?    @relation(fields: [userId], references: [id])
  userId              Int?
  createdAt           DateTime @default(now())
}

model Village {
  id        Int      @id @unique @default(autoincrement())
  name      String
  location  String
  createdAt DateTime @default(now())
  users     User[] // Added this line to establish the reverse relation
}
